# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）。
# 静态站点在构建期读取 SITE_URL 与 CONTENT_REPOSITORY，修改后需重新构建镜像。

# 正式站点地址，用于 RSS 与规范链接。
SITE_URL=https://notes.example.com
# 可选：自己的 GitHub 仓库，启用 /admin/ 写作入口。
# CONTENT_REPOSITORY=your-name/zanuain-blog

# 宿主机对外端口，由前置反向代理转发到这里。
WEB_PORT=8080

# 书签服务的允许来源，必须与浏览器访问的站点地址完全一致（含协议与端口）。
# NODE_ENV=production 时必须是 HTTPS，否则服务会拒绝启动。
BOOKMARKS_ORIGINS=https://notes.example.com
