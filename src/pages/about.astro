---
import Base from '../layouts/Base.astro';
import AboutTerminal from '../components/AboutTerminal';
import { formatDate, getNotes, getTags, noteUrl, tagUrl } from '../lib/notes';
import { site, repositoryUrl } from '../site.config';
const notes = await getNotes();
const tags = getTags(notes);
const context = {
  name: site.name,
  description: site.description,
  notes: notes.map(note => ({ title: note.data.title, description: note.data.description, date: formatDate(note.data.date), category: note.data.category, href: noteUrl(note.id), tags: note.data.tags })),
  tags: tags.map(tag => ({ ...tag, href: tagUrl(tag.name) })),
  repository: site.repository ? repositoryUrl : '',
};
---
<Base title="关于">
  <section class="page-head"><h1>关于 {site.name}</h1><p>这里是我的个人学习笔记站，记录日常真正会用到的知识。</p></section>
  <AboutTerminal client:load context={context} />
  <div class="terminal-source" id="source"><p>终端基于 <a href="https://github.com/SimonAKing/TermFolio" target="_blank" rel="noreferrer">TermFolio</a> · <a href="/licenses/termfolio-LICENSE.txt">MIT License</a></p><p><a href="/#feed">浏览笔记</a> · <a href="/admin/">写作入口</a> · {site.repository ? <a href={repositoryUrl}>站点源码</a> : <span>源码仓库尚未配置</span>}</p></div>
</Base>
