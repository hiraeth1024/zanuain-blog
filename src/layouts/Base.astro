---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site, repositoryUrl } from '../site.config';
interface Props { title?: string; description?: string; }
const { title = '学习笔记', description = site.description } = Astro.props;
const path = Astro.url.pathname;
const nav = [{ href: '/', label: '笔记' }, { href: '/tags/', label: '标签' }, { href: '/bookmarks/', label: '书签' }, { href: '/about/', label: '关于' }];
---
<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (() => {
        let theme = 'light';
        try { if (localStorage.getItem('zanuain-theme') === 'dark') theme = 'dark'; } catch {}
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').content = theme === 'dark' ? '#191919' : '#ffffff';
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=matrix-swapped" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=matrix-swapped" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} 的学习笔记`} href="/rss.xml" />
    <title>{title} · {site.name}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label={`${site.name} 首页`}><span class="brand-mark" aria-hidden="true"></span><span>{site.name}<span class="brand-cursor">.</span></span></a>
        <button class="menu-toggle" aria-label="展开菜单" aria-controls="site-navigation" aria-expanded="false"><Icon name="menu" size={18} /><span>菜单</span></button>
        <div class="header-actions" id="site-navigation">
          <nav aria-label="主导航">{nav.map(item => <a class:list={['nav-link', { active: item.href === '/' ? path === '/' || path.startsWith('/notes/') : path.startsWith(item.href) }]} href={item.href} aria-current={(item.href === '/' ? path === '/' : path === item.href) ? 'page' : undefined}>{item.label}</a>)}</nav>
          <a class="header-search" href="/search/" aria-label="搜索笔记"><Icon name="search" size={15} /><span>搜索笔记</span><kbd>/</kbd></a>
          <a class="rss-link" href="/rss.xml">RSS</a>
        </div>
        <ThemeToggle />
      </div>
    </header>
    <main class="site-main" id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer"><div class="footer-inner"><p><span class="status-dot" aria-hidden="true"></span>© {new Date().getFullYear()} {site.name}<span class="footer-divider">/</span><span>notes & bookmarks · Astro</span></p><nav aria-label="页脚导航"><a href="/search/">搜索</a><a href="/rss.xml">RSS</a><a href={repositoryUrl}>GitHub</a><a href="/admin/">写作</a></nav></div></footer>
    <script>
      document.documentElement.classList.add('js-ready');
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('.header-actions');
      const closeMenu = () => { navigation?.classList.remove('is-open'); toggle?.setAttribute('aria-expanded', 'false'); toggle?.setAttribute('aria-label', '展开菜单'); };
      toggle?.addEventListener('click', () => {
        const open = navigation?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(Boolean(open)));
        toggle.setAttribute('aria-label', open ? '收起菜单' : '展开菜单');
      });
      document.addEventListener('click', event => { if (event.target instanceof Node && !navigation?.contains(event.target) && !toggle?.contains(event.target)) closeMenu(); });
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape') closeMenu();
        const target = event.target;
        const editing = target instanceof HTMLElement && (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName));
        if (editing || event.altKey || event.shiftKey) return;
        if ((!event.metaKey && !event.ctrlKey && event.key === '/') || ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k')) {
          event.preventDefault();
          const input = document.querySelector<HTMLInputElement>('#note-search');
          if (input) input.focus(); else location.assign('/search/');
        }
      });
    </script>
  </body>
</html>
